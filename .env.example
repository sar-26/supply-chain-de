# Copy to .env and fill in. Do NOT commit .env to git.

DB_USER=ADMIN
DB_PASSWORD=your_admin_password

# A connection alias from tnsnames.ora inside the wallet (low/medium/high).
DB_DSN=scmdb_low

# Folder containing the unzipped wallet (must hold tnsnames.ora + ewallet.pem).
WALLET_DIR=/absolute/path/to/wallet

# The wallet password you set when downloading the wallet (NOT the ADMIN password).
WALLET_PASSWORD=your_wallet_password
