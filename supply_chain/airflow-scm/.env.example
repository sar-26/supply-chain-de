# Copy to .env in the airflow-scm/ root and fill in the two secrets.
# Astro injects these into the Airflow containers automatically.

DB_USER=ADMIN
DB_PASSWORD=your_admin_password
DB_DATABASE=scmdb
DB_HOST=adb.<your-region>.oraclecloud.com
DB_SERVICE=<your-service-name-from-tnsnames>_low.adb.oraclecloud.com
DB_SCHEMA=ADMIN
ANTHROPIC_API_KEY=sk-ant-...
